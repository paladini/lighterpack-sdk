# Only needed to run scripts/verify-live-login.ts and the opt-in
# integration test suite (tests/integration/*) against a real account.
LIGHTERPACK_USERNAME=
LIGHTERPACK_PASSWORD=

# Optional: point at a self-hosted LighterPack instance instead of lighterpack.com.
# LIGHTERPACK_BASE_URL=https://lighterpack.com

# RUN_INTEGRATION=1
